# 复制为 .env，填写自己的密钥；不要上传 .env。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=180
# 以下为兼容设置，通常无需修改；详情见 docs/internal/MAINTENANCE.md。
AI_JSON_MODE=true
AI_TEMPERATURE=omit
AI_TOKEN_PARAMETER=max_tokens
# DeepSeek 可使用 disabled/enabled；其他服务请改为 omit。
AI_THINKING=disabled
